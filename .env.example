# Discord User Token (required)
# Get this from browser dev tools - see README for instructions
DISCORD_TOKEN=your_user_token_here

# Welcome Channel ID (optional)
# If not set, the bot will look for a channel named "welcome", "general", or use the system channel
WELCOME_CHANNEL_ID=

# Log Level (optional, defaults to "INFO")
# Options: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Subscribe to member events (optional, defaults to true)
# Required to receive on_member_join events
# See: https://discordpy-self.readthedocs.io/en/latest/guild_subscriptions.html
SUBSCRIBE_TO_MEMBER_EVENTS=true
