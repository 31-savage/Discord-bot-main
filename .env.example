# Discord User Token (required)
# Get this from browser dev tools - see README for instructions
DISCORD_TOKEN=your_user_token_here

# Notification Channel ID (required)
# Create a group DM and get its channel ID
# To get the ID: Enable Developer Mode in Discord settings,
# then right-click the group chat and "Copy Channel ID"
NOTIFICATION_CHANNEL_ID=123456789

# Log Level (optional, defaults to "INFO")
# Options: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Command Prefix (optional, defaults to "!")
COMMAND_PREFIX=!

# Data Directory for persistent storage (optional, defaults to ".")
# On Railway: Create a volume, mount it to /app/data, and set DATA_DIR=/app/data
DATA_DIR=.
